<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Drafters.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Requisition System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/Content/delivery.css" rel="stylesheet" runat="server" />
    <style>
        :root { --dk-blue:#0097e0; --dk-blue-dark:#0078b8; --dk-ink:#12384f; }
        body { font-family:'Poppins',system-ui,-apple-system,'Segoe UI',sans-serif; color:var(--dk-ink);
               background:linear-gradient(180deg,#e6f5fd 0%,#f4fafe 100%) fixed; min-height:100vh; }
        h3, h4, h5 { font-weight:600; color:#0d3550; }
        .card { border:0; border-radius:16px; box-shadow:0 4px 18px rgba(0,110,180,.10); }
        .card-header { border-top-left-radius:16px !important; border-top-right-radius:16px !important; }
        .navbar-daikin { background:#fff; box-shadow:0 2px 16px rgba(0,120,184,.14); }
        .navbar-daikin .nav-link { color:#35637d; font-weight:500; font-size:14px; }
        .navbar-daikin .nav-link:hover, .navbar-daikin .nav-link:focus { color:var(--dk-blue); }
        .brand-logo { height:26px; width:auto; display:block; }
        .brand-sub { font-size:12px; font-weight:500; color:#6b8ea3; letter-spacing:.04em; border-left:1px solid #cfe7f4; padding-left:10px; margin-left:10px; }
        .btn { border-radius:10px; font-weight:500; }
        .btn-dark, .btn-primary { --bs-btn-bg:#0097e0; --bs-btn-border-color:#0097e0; --bs-btn-hover-bg:#0082c4; --bs-btn-hover-border-color:#0082c4;
            --bs-btn-active-bg:#0074b0; --bs-btn-active-border-color:#0074b0; --bs-btn-color:#fff; --bs-btn-hover-color:#fff; --bs-btn-active-color:#fff; }
        .btn-outline-dark, .btn-outline-primary { --bs-btn-color:#0078b8; --bs-btn-border-color:#8fd0f0; --bs-btn-hover-bg:#0097e0;
            --bs-btn-hover-border-color:#0097e0; --bs-btn-hover-color:#fff; --bs-btn-active-bg:#0082c4; --bs-btn-active-border-color:#0082c4; --bs-btn-active-color:#fff; }
        .table-light { --bs-table-bg:#e6f5fd; --bs-table-color:#12384f; }
        .table > :not(caption) > * > * { padding-top:.7rem; padding-bottom:.7rem; }
        .form-control, .form-select { border-radius:10px; border-color:#cfe7f4; }
        .form-control:focus, .form-select:focus { border-color:var(--dk-blue); box-shadow:0 0 0 .2rem rgba(0,151,224,.18); }
        a { color:var(--dk-blue-dark); }
        @media print { .no-print { display:none !important; } body { background:#fff; } }

        /* ===== left sidebar layout ===== */
        :root { --sb-w:264px; }
        .ic { fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
        .sidebar { position:fixed; top:0; bottom:0; left:0; width:var(--sb-w); background:#fff; border-right:1px solid #dcedf8;
            display:flex; flex-direction:column; padding:22px 16px 16px; z-index:1040; overflow-y:auto; transition:transform .25s ease;
            box-shadow:4px 0 24px rgba(0,110,180,.06); }
        .sb-brand { display:block; padding:0 8px; }
        .sb-brand svg { height:30px; width:auto; display:block; }
        .sb-sub { font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:#7f9fb2; font-weight:500; padding:6px 8px 0; }
        .sb-user { display:flex; align-items:center; gap:12px; margin:22px 4px 8px; padding:12px; border-radius:14px;
            background:linear-gradient(135deg,#eaf7fe,#f6fcff); border:1px solid #d7edf9; }
        .sb-avatar { width:42px; height:42px; flex:0 0 42px; border-radius:50%; background:linear-gradient(135deg,#27b0f0,#0086cc); color:#fff;
            font-weight:600; font-size:15px; display:flex; align-items:center; justify-content:center; }
        .sb-avatar.sm { width:34px; height:34px; flex-basis:34px; font-size:13px; }
        .sb-name { font-weight:600; font-size:13.5px; line-height:1.25; color:#0d3550; }
        .sb-role { font-size:11.5px; color:#6b8ea3; }
        .sb-section { font-size:10.5px; letter-spacing:.16em; color:#9ab6c6; font-weight:600; padding:16px 12px 6px; }
        .sb-nav { display:flex; flex-direction:column; gap:3px; }
        .sb-link { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:12px; color:#35637d !important;
            font-weight:500; font-size:14px; text-decoration:none; position:relative; transition:background .15s, color .15s; }
        .sb-link .ic { width:19px; height:19px; flex:0 0 19px; }
        .sb-link:hover { background:#eef8fd; color:#0078b8 !important; }
        .sb-link.active { background:linear-gradient(90deg,#dff2fc,#eef8fd); color:#0078b8 !important; font-weight:600; }
        .sb-link.active::before { content:""; position:absolute; left:-16px; top:8px; bottom:8px; width:4px; border-radius:0 4px 4px 0; background:#0097e0; }
        .sb-link .notif-badge { margin-left:auto; }
        .sb-bottom { margin-top:auto; padding-top:14px; border-top:1px solid #e3f1f9; }
        .sb-logout { color:#c0392b !important; }
        .sb-logout:hover { background:#fdeeee; color:#b42318 !important; }

        .main-wrap.with-sidebar { margin-left:var(--sb-w); }
        .topbar { position:sticky; top:0; z-index:1030; height:64px; display:flex; align-items:center; gap:14px; padding:0 28px;
            background:rgba(255,255,255,.88); backdrop-filter:blur(8px); border-bottom:1px solid #dcedf8; }
        .tb-crumb { font-size:13px; color:#7f9fb2; }
        .tb-crumb b { color:#0d3550; font-weight:600; }
        .tb-crumb span { margin:0 6px; }
        .tb-right { margin-left:auto; display:flex; align-items:center; gap:18px; }
        .tb-bell { position:relative; width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center;
            color:#35637d; background:#eef8fd; text-decoration:none; }
        .tb-bell .ic { width:20px; height:20px; }
        .tb-bell:hover { background:#dff2fc; color:#0078b8; }
        .tb-bell .notif-badge { position:absolute; top:-3px; right:-3px; font-size:10px; }
        .tb-user { display:flex; align-items:center; gap:10px; font-size:13px; font-weight:500; color:#0d3550; }
        .tb-toggle { display:none; border:0; background:#eef8fd; width:40px; height:40px; border-radius:10px; color:#0078b8; }
        .tb-toggle .ic { width:22px; height:22px; }
        .content-area { padding:28px; max-width:1500px; }
        .sidebar-backdrop { display:none; }
        @media (max-width: 991.98px) {
            .sidebar { transform:translateX(-100%); }
            body.sb-open .sidebar { transform:translateX(0); }
            body.sb-open .sidebar-backdrop { display:block; position:fixed; inset:0; background:rgba(8,40,60,.4); z-index:1035; }
            .main-wrap.with-sidebar { margin-left:0; }
            .tb-toggle { display:flex; align-items:center; justify-content:center; }
            .topbar { padding:0 16px; }
            .content-area { padding:18px 14px; }
        }
        @media print { .main-wrap.with-sidebar { margin-left:0; } .content-area { padding:0; max-width:none; } }
    </style>
</head>
<body>
<form id="form1" runat="server">

    <% if (LoggedIn) { %>
    <div class="sidebar-backdrop no-print" id="sbBackdrop"></div>
    <aside class="sidebar no-print" id="sidebar">
        <a class="sb-brand" href="<%= HomeUrl %>">
            <svg viewBox="0 0 460 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Daikin">
                <polygon points="11,0 59,25 6,48" fill="#0f1a24"></polygon>
                <polygon points="6,48 59,25 100,46 0,100" fill="#2aa9e0"></polygon>
                <text x="122" y="80" font-family="Poppins, Arial, sans-serif" font-weight="800" font-size="84" fill="#0a98de" textLength="330" lengthAdjust="spacingAndGlyphs">DAIKIN</text>
            </svg>
        </a>
        <div class="sb-sub">Drafters System</div>

        <div class="sb-user">
            <div class="sb-avatar"><%= Server.HtmlEncode(Initials) %></div>
            <div>
                <div class="sb-name"><%= Server.HtmlEncode(FullName) %></div>
                <div class="sb-role"><%= Server.HtmlEncode(RoleLabel) %> &middot; <%= Server.HtmlEncode(EmpId) %></div>
            </div>
        </div>

        <div class="sb-section"><%= Role == "Delivery" ? "DELIVERY" : "MENU" %></div>
        <nav class="sb-nav">
            <% if (Role == "Admin") { %>
            <a class="sb-link <%= Active("Default.aspx") %>" href="<%= ResolveUrl("~/Default.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                Admin Dashboard</a>
            <a class="sb-link <%= Active("Requests.aspx", "RequestDetails.aspx", "SlipPrint.aspx") %>" href="<%= ResolveUrl("~/Requests.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"></path><rect x="5" y="6" width="14" height="15" rx="2"></rect><path d="M9 12h6M9 16h4"></path></svg>
                Requisition Management</a>
            <a class="sb-link <%= Active("Inventory.aspx", "ItemEdit.aspx") %>" href="<%= ResolveUrl("~/Inventory.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8M12 13v8"></path></svg>
                Inventory Management</a>
            <a class="sb-link <%= Active("Replenishment.aspx") %>" href="<%= ResolveUrl("~/Replenishment.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg>
                Purchasing Management</a>
            <a class="sb-link <%= Active("DeliveryManagement.aspx") %>" href="<%= ResolveUrl("~/DeliveryManagement.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                Delivery Management</a>
            <a class="sb-link <%= Active("Users.aspx") %>" href="<%= ResolveUrl("~/Users.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"></path></svg>
                User Management</a>
            <% } else if (Role == "Inventory") { %>
            <a class="sb-link <%= Active("InventoryDashboard.aspx") %>" href="<%= ResolveUrl("~/InventoryDashboard.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                Inventory Dashboard</a>
            <a class="sb-link <%= Active("Requests.aspx", "RequestDetails.aspx", "SlipPrint.aspx") %>" href="<%= ResolveUrl("~/Requests.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"></path><rect x="5" y="6" width="14" height="15" rx="2"></rect><path d="M9 12h6M9 16h4"></path></svg>
                Requisitions</a>
            <a class="sb-link <%= Active("Inventory.aspx", "ItemEdit.aspx") %>" href="<%= ResolveUrl("~/Inventory.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8M12 13v8"></path></svg>
                Inventory</a>
            <a class="sb-link <%= Active("Replenishment.aspx") %>" href="<%= ResolveUrl("~/Replenishment.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg>
                Replenishment (RepF)</a>
            <% } else if (Role == "Purchasing") { %>
            <a class="sb-link <%= Active("PurchasingDashboard.aspx") %>" href="<%= ResolveUrl("~/PurchasingDashboard.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                Purchasing Dashboard</a>
            <a class="sb-link <%= Active("Replenishment.aspx") %>" href="<%= ResolveUrl("~/Replenishment.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg>
                Replenishment (RepF)</a>
            <% } else if (Role == "Requester") { %>
            <a class="sb-link <%= Active("RequestForm.aspx") %>" href="<%= ResolveUrl("~/RequestForm.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>
                New Requisition</a>
            <a class="sb-link <%= Active("Requests.aspx", "RequestDetails.aspx", "SlipPrint.aspx") %>" href="<%= ResolveUrl("~/Requests.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"></path><rect x="5" y="6" width="14" height="15" rx="2"></rect><path d="M9 12h6M9 16h4"></path></svg>
                My Requests</a>
            <% } else if (Role == "Delivery") { %>
            <a class="sb-link <%= Active("Dashboard.aspx") %>" href="<%= ResolveUrl("~/Delivery/Dashboard.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                Delivery Dashboard</a>
            <a class="sb-link <%= Active("DeliveryNotices.aspx") %>" href="<%= ResolveUrl("~/Delivery/DeliveryNotices.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
                Delivery Notices</a>
            <a class="sb-link <%= Active("Receiving.aspx") %>" href="<%= ResolveUrl("~/Delivery/Receiving.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                Receiving</a>
            <a class="sb-link <%= Active("Discrepancies.aspx") %>" href="<%= ResolveUrl("~/Delivery/Discrepancies.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
                Discrepancies</a>
            <a class="sb-link <%= Active("Verification.aspx") %>" href="<%= ResolveUrl("~/Delivery/Verification.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"></path><path d="M22 4L12 14l-3-3"></path></svg>
                Verification</a>
            <a class="sb-link <%= Active("Release.aspx") %>" href="<%= ResolveUrl("~/Delivery/Release.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7z"></path><path d="M3.3 7L12 12l8.7-5M12 22V12"></path></svg>
                Invoice &amp; Release</a>
            <a class="sb-link <%= Active("DeliveryRecords.aspx") %>" href="<%= ResolveUrl("~/Delivery/DeliveryRecords.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.7-4 3-9 3s-9-1.3-9-3"></path><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"></path></svg>
                Delivery Records</a>
            <% } %>
            <a class="sb-link <%= Active("Notifications.aspx") %>" href="<%= ResolveUrl("~/Notifications.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg>
                Notifications
                <span class="badge bg-danger notif-badge <%= (Unread > 0) ? "" : "d-none" %>"><%= Unread %></span></a>
        </nav>

        <div class="sb-bottom">
            <a class="sb-link sb-logout" href="<%= ResolveUrl("~/Logout.aspx") %>">
                <svg class="ic" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5M21 12H9"></path></svg>
                Logout</a>
        </div>
    </aside>
    <% } %>

    <div class="main-wrap <%= LoggedIn ? "with-sidebar" : "" %>">
        <% if (LoggedIn) { %>
        <header class="topbar no-print">
            <button type="button" class="tb-toggle" id="sbToggle" aria-label="Open menu">
                <svg class="ic" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
            <div class="tb-crumb"><%= InDelivery ? "Daikin Delivery" : "Daikin Drafters" %> <span>/</span> <b><%= Server.HtmlEncode(Page.Title) %></b></div>
            <div class="tb-right">
                <a class="tb-bell" href="<%= ResolveUrl("~/Notifications.aspx") %>" title="Notifications">
                    <svg class="ic" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg>
                    <span class="badge rounded-pill bg-danger notif-badge <%= (Unread > 0) ? "" : "d-none" %>"><%= Unread %></span>
                </a>
                <div class="tb-user"><div class="sb-avatar sm"><%= Server.HtmlEncode(Initials) %></div><span class="d-none d-md-inline"><%= Server.HtmlEncode(FullName) %></span></div>
            </div>
        </header>
        <% } %>

        <div class="content-area">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </div>

    <%-- pop-up notifications (top right) --%>
    <div id="toasts" class="toast-container position-fixed top-0 end-0 p-3 no-print" style="z-index:2000"></div>

    <%-- pop-up result message --%>
    <div class="modal fade" id="msgModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="msgTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body" id="msgBody"></div>
        <div class="modal-footer"><button type="button" class="btn btn-dark" data-bs-dismiss="modal">OK</button></div>
    </div></div></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var ok = <%= FlashSuccessJson %>;
            var err = <%= FlashErrorJson %>;
            if (ok || err) {
                document.getElementById('msgTitle').textContent = ok ? 'Success' : 'Notice';
                document.getElementById('msgTitle').className = 'modal-title ' + (ok ? 'text-success' : 'text-danger');
                document.getElementById('msgBody').textContent = ok || err;
                new bootstrap.Modal(document.getElementById('msgModal')).show();
            }
        })();
    </script>
    <% if (LoggedIn) { %>
    <script>
        (function () {
            var t = document.getElementById('sbToggle'), bd = document.getElementById('sbBackdrop');
            if (t) t.addEventListener('click', function () { document.body.classList.toggle('sb-open'); });
            if (bd) bd.addEventListener('click', function () { document.body.classList.remove('sb-open'); });
        })();
    </script>
    <script>
        (function () {
            var KEY = 'lastNotifId';
            function showToast(n) {
                var el = document.createElement('div');
                el.className = 'toast';
                el.innerHTML = '<div class="toast-header"><strong class="me-auto">New notification</strong><button type="button" class="btn-close" data-bs-dismiss="toast"></button></div><div class="toast-body"></div>';
                var a = document.createElement('a');
                a.href = n.Link; a.textContent = n.Message;
                el.querySelector('.toast-body').appendChild(a);
                document.getElementById('toasts').appendChild(el);
                new bootstrap.Toast(el, { delay: 12000 }).show();
            }
            function poll() {
                var after = parseInt(sessionStorage.getItem(KEY) || '0', 10);
                fetch('<%= ResolveUrl("~/Notifications.ashx") %>?afterId=' + after, { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        d.items.forEach(function (n) { showToast(n); sessionStorage.setItem(KEY, n.NotifId); });
                        Array.prototype.forEach.call(document.querySelectorAll('.notif-badge'), function (b) {
                            b.textContent = d.unread;
                            if (d.unread > 0) b.classList.remove('d-none'); else b.classList.add('d-none');
                        });
                    }).catch(function () { });
            }
            poll();
            setInterval(poll, 8000);
        })();
    </script>
    <% } %>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
</form>
</body>
</html>
